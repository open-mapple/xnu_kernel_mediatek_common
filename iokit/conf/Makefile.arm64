######################################################################
#BEGIN  Machine dependent Makefile fragment for arm
######################################################################
#
# XXX: CFLAGS
#
CWARNFLAGS   = $(CWARNFLAGS_STD) -Wno-unused-parameter  -Wshorten-64-to-32 -Wimplicit-int-conversion
CXXWARNFLAGS = $(CXXWARNFLAGS_STD) -Wno-unused-parameter -Wno-cast-qual -Wno-shadow  -Wshorten-64-to-32 -Wimplicit-int-conversion

# Files that must go in the __HIB segment:
UNCONFIGURED_HIB_FILES=	\
			IOHibernateRestoreKernel.o

HIB_FILES=$(filter $(UNCONFIGURED_HIB_FILES),$(OBJS))

# Unconfigured __HIB files must be Mach-O for "setsegname"
# KASAN must be disabled for unconfigured __HIB files
# because the kasan runtime isn't available during hibernation resume
IOHibernateRestoreKernel.o_CFLAGS_ADD += $(CFLAGS_NOLTO_FLAG) -fno-sanitize=address -UKASAN
# Stack protector and stack check must be disabled because the stack protector runtime isn't available
IOHibernateRestoreKernel.o_CFLAGS_ADD += -fno-stack-protector -fno-stack-check

IOHibernateIO.cpo_INCFLAGS += -I$(SRCROOT)/osfmk
IOHibernateRestoreKernel.o_INCFLAGS += -I$(SRCROOT)/osfmk

# IOHIDFamily-1915.140.3's sources build as Apple wrote them
HID_IMPORTED_CXXWARNFLAGS = -Wno-zero-as-null-pointer-constant -Wno-documentation -Wno-implicit-int-conversion \
	-Wno-cast-align -Wno-missing-field-initializers
IOHIDResource.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDResourceUserClient.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDUserDevice.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDDevice.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDInterface.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDElementPrivate.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDElementContainer.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDDeviceElementContainer.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDEventQueue.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDEventSource.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
IOHIDFamilyPrivate.cpo_CXXWARNFLAGS_ADD += $(HID_IMPORTED_CXXWARNFLAGS)
MappleHIDKeyboard.cpo_CXXWARNFLAGS_ADD += -Wno-zero-as-null-pointer-constant -Wno-documentation
HIDCountDescriptorItems.o_CWARNFLAGS_ADD += -Wno-cast-align
HIDOpenCloseDescriptor.o_CWARNFLAGS_ADD += -Wno-declaration-after-statement

######################################################################
#END    Machine dependent Makefile fragment for arm
######################################################################
